# ========================================
# HIS报表查询系统 - 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ========================================

# 数据库连接配置
# 格式（SID 形式，冒号）：jdbc:oracle:thin:@<HIS_HOST>:<HIS_PORT>:<SID>
# 格式（服务名形式，斜杠）：jdbc:oracle:thin:@//<HIS_HOST>:<HIS_PORT>/<SERVICE_NAME>
# 下面是占位符，请换成现场真实值（真实连接串不要提交回仓库）
DB_URL=jdbc:oracle:thin:@<HIS_HOST>:<HIS_PORT>:<SID>
DB_USERNAME=<HIS_USER>
DB_PASSWORD=<DB_PASSWORD>
# ⚠️ DB_USERNAME / DB_PASSWORD 已**不再有示例默认值**（早先缺 .env 时会按 scott/tiger@localhost
#   起一个必失败的连接池、只留一行 WARN）。留空即连不上，由启动自检与 /actuator/health 明确报出。

# 管理员账号配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<ADMIN_PASSWORD>
# 说明：DB_PASSWORD / ADMIN_PASSWORD 可填 "enc:" 前缀的 AES-256-GCM 密文，
# 解密前提是同目录存在 secret.key（APP_CRYPTO_KEY）。生成密文：java -cp target/tools SecretKeyTool enc <密钥> DB_PASSWORD=真实口令
# 由 启动服务.bat 注入为环境变量；应用本身不读取本文件（详见 部署说明.md）

# 应用目录配置
APP_LOG_DIR=./logs
APP_DATA_DIR=./data
APP_SCRIPTS_DIR=./scripts

# 数据源密码落盘加密密钥（建议随机长串；配置后 datasources.json 中密码以 enc: 存储）
# APP_CRYPTO_KEY=change-me-to-a-long-random-secret

# 服务端口（默认 8090，可用 SERVER_PORT 覆盖）
SERVER_PORT=8090

# 新建账号 / 重置口令时下发的初始口令。默认值是历史沿用的共享口令，便于统一告知用户，
# 但它公开可猜 —— 对外部署时建议改成一个只有管理员知道的值。
# INITIAL_USER_PASSWORD=666999

# 跨源白名单（逗号分隔）。★ 默认**空 = 不接受任何跨源**：前端页面与接口同源，本就不需要 CORS。
# 早先出厂放的是「10.* / 172.16-31.* / 192.168.* 整段内网 + allowCredentials(true)」，
# 等于内网任意终端上的任意页面都能带着已登录 Cookie 读 /api/**。
# 只有确需浏览器端跨源调用时才填，例如 Grafana 直连查询：
# CORS_ALLOWED_ORIGINS=http://grafana.internal:3000

# 表单登录按 IP 限速（次/分钟）。POST /login 走 Security 过滤器、不经过 /api/** 限流拦截器，
# 靠这一条挡住「同一口令遍历短工号段」的暴力破解。
# 本机回环（127.0.0.1 / ::1）不受此限速 —— 本机自检与自动化测试需要连续登录。
# LOGIN_PER_IP_PER_MINUTE=10
